APP_NAME=api-example
APP_ENV=local
APP_PORT=8080
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=api_example
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DOCUMENT_QUEUE=api_example:documents
REDIS_DOCUMENT_PROCESSING_QUEUE=api_example:documents:processing
REDIS_DOCUMENT_DEAD_LETTER_QUEUE=api_example:documents:dead
REDIS_DOCUMENT_MAX_ATTEMPTS=3

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=api-example
JWT_AUDIENCE=api-example-client
JWT_ACCESS_TOKEN_EXPIRY=8h
JWT_REFRESH_TOKEN_EXPIRY=720h

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./data
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_ALLOWED_MEDIA_TYPES=application/pdf,image/jpeg,image/png,text/plain

S3_REGION=us-east-1
S3_BUCKET=api-example
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_USE_PATH_STYLE=true

LOG_LEVEL=debug
LOG_FORMAT=colored_text
CORS_ALLOWED_ORIGINS=http://localhost:3000
